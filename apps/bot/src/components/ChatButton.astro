---

<a
  href="/chat"
  target="_blank"
  rel="noopener noreferrer"
  class="border-border bg-main text-main-foreground shadow-shadow hover:translate-x-boxShadowX hover:translate-y-boxShadowY focus-visible:outline-hidden group inline-flex h-12 w-full cursor-pointer items-center gap-3 border-2 px-5 font-mono text-base font-bold transition-all hover:shadow-none focus-visible:ring-2 focus-visible:ring-black focus-visible:ring-offset-2"
  data-umami-event="chat"
>
  <span class="text-main-foreground/60">&gt;</span>
  <span>start chat</span>
  <span class="cursor-blink ml-auto" aria-hidden="true">▍</span>
</a>

<style>
  @keyframes blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }

  .cursor-blink {
    animation: blink 1.1s steps(1) infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor-blink {
      animation: none;
    }
  }
</style>
